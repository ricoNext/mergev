{
  "compilerOptions": {
	"baseUrl": ".",
	"paths": {
	  "@mergev/merge-ui": ["../../packages/merge-ui/src/index.ts"],
	  "@mergev/merge-ui/*": ["../../packages/merge-ui/src/*"]
	},
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "types": ["node", "vscode"]
  },
  "include": ["src/extension.ts", "src/webview.tsx"]
}
